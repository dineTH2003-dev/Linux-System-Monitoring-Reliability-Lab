{{/* Alertmanager Notification Templates */}}
{{/* Project: Linux System Monitoring & Reliability Lab */}}
{{/* Role: Agent 7 (Senior SRE - Incident Detection & Alert Engineering) */}}

{{ define "slack.title" }}
[{{ .Status | toUpper }}{{ if eq .Status "firing" }}:{{ .Alerts.Firing | len }}{{ end }}] {{ .GroupLabels.alertname }} ({{ .CommonLabels.severity | toUpper }})
{{ end }}

{{ define "slack.text" }}
{{ range .Alerts }}
*Alert:* `{{ .Labels.alertname }}`
*Severity:* `{{ .Labels.severity }}`
*Instance:* `{{ .Labels.instance }}`
*Subsystem:* `{{ .Labels.subsystem }}`
*Summary:* {{ .Annotations.summary }}
*Description:* {{ .Annotations.description }}
{{ if .Annotations.diagnostic_command }}*Diagnostic Command:* `{{ .Annotations.diagnostic_command }}`{{ end }}
{{ if .Annotations.runbook_url }}*Runbook:* <{{ .Annotations.runbook_url }}|Open Incident Runbook>{{ end }}
*Active Since:* {{ .StartsAt.Format "2006-01-02 15:04:05 MST" }}
---
{{ end }}
{{ end }}

{{ define "email.subject" }}
[{{ .Status | toUpper }}] [{{ .CommonLabels.severity | toUpper }}] {{ .GroupLabels.alertname }} on {{ .CommonLabels.instance }}
{{ end }}

{{ define "email.html" }}
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; line-height: 1.5; color: #333; }
    .status-firing { background-color: #d9534f; color: white; padding: 4px 8px; border-radius: 4px; }
    .status-resolved { background-color: #5cb85c; color: white; padding: 4px 8px; border-radius: 4px; }
    .alert-card { border: 1px solid #ddd; border-radius: 6px; padding: 16px; margin-bottom: 16px; background-color: #fdfdfd; }
    .badge-critical { background-color: #d9534f; color: white; padding: 2px 6px; border-radius: 3px; font-size: 12px; }
    .badge-warning { background-color: #f0ad4e; color: white; padding: 2px 6px; border-radius: 3px; font-size: 12px; }
    code { background-color: #eee; padding: 2px 4px; border-radius: 3px; font-family: monospace; }
  </style>
</head>
<body>
  <h2>Observability Alert Notification</h2>
  <p>Status: <span class="status-{{ .Status }}">{{ .Status | toUpper }}</span></p>
  {{ range .Alerts }}
  <div class="alert-card">
    <h3>{{ .Labels.alertname }} <span class="badge-{{ .Labels.severity }}">{{ .Labels.severity | toUpper }}</span></h3>
    <p><strong>Summary:</strong> {{ .Annotations.summary }}</p>
    <p><strong>Description:</strong> {{ .Annotations.description }}</p>
    <p><strong>Affected Target:</strong> <code>{{ .Labels.instance }}</code> (Subsystem: <code>{{ .Labels.subsystem }}</code>)</p>
    {{ if .Annotations.diagnostic_command }}
    <p><strong>Triage Command:</strong> <code>{{ .Annotations.diagnostic_command }}</code></p>
    {{ end }}
    {{ if .Annotations.runbook_url }}
    <p><strong>Runbook:</strong> <a href="{{ .Annotations.runbook_url }}">{{ .Annotations.runbook_url }}</a></p>
    {{ end }}
    <p><small>Alert Active Since: {{ .StartsAt.Format "2006-01-02 15:04:05 MST" }}</small></p>
  </div>
  {{ end }}
</body>
</html>
{{ end }}
