# ==============================================================================
# Linux System Monitoring & Reliability Lab
# Environment Configuration Template (.env.example)
#
# IMPORTANT: Copy this file to .env before starting the stack:
#   cp .env.example .env
#   chmod 600 .env
#
# NEVER commit the active .env file or real credentials to source control.
# .env is explicitly excluded in .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project & Environment Identity
# ------------------------------------------------------------------------------
ENVIRONMENT=lab
COMPOSE_PROJECT_NAME=monitoring-lab
HOST_HOSTNAME=monitoring-node-01

# ------------------------------------------------------------------------------
# 2. Network Interface & Port Bindings (Strictly Loopback Bound)
# ------------------------------------------------------------------------------
# Standard host services (Prometheus :9090, Grafana :3000, Node Exporter :9100)
# are preserved. The lab services bind strictly to 127.0.0.1 on isolated ports.
HOST_BIND_IP=127.0.0.1

PROMETHEUS_HOST_PORT=9091
GRAFANA_HOST_PORT=3001
ALERTMANAGER_HOST_PORT=9093
LOKI_HOST_PORT=3100
BLACKBOX_HOST_PORT=9115
ALLOY_HOST_PORT=12345
PYTHON_AGENT_HOST_PORT=9101

# ------------------------------------------------------------------------------
# 3. Grafana Security & Authentication
# ------------------------------------------------------------------------------
# Set a strong, randomly generated administrator password (min 16 characters)
# Example generation: openssl rand -base64 24
GF_SECURITY_ADMIN_USER=labadmin
GF_SECURITY_ADMIN_PASSWORD=CHANGEME_SECURE_GRAFANA_ADMIN_PASSWORD_MIN_16_CHARS
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_SECURITY_COOKIE_SECURE=false
GF_SECURITY_STRICT_TRANSPORT_SECURITY=false

# ------------------------------------------------------------------------------
# 4. Prometheus Storage & Retention Boundaries
# ------------------------------------------------------------------------------
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB
PROMETHEUS_MEMORY_LIMIT=1024M
PROMETHEUS_CPU_LIMIT=1.0

# ------------------------------------------------------------------------------
# 5. Alertmanager Notification Tokens (Sanitized Placeholders)
# ------------------------------------------------------------------------------
# Webhook URL for external incident notifications (Slack / Discord / Mattermost)
# Set to an active webhook URL or leave as dummy in local lab mode
ALERTMANAGER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/CHANGEME_WEBHOOK_TOKEN
ALERTMANAGER_SLACK_CHANNEL=#monitoring-alerts

# SMTP Relay Configuration (if email alerting is configured)
SMTP_SMARTHOST=smtp.example.com:587
SMTP_FROM=alerts@lab.internal
SMTP_AUTH_USERNAME=monitoring-alerts
SMTP_AUTH_PASSWORD=CHANGEME_SECURE_SMTP_PASSWORD
SMTP_REQUIRE_TLS=true

# PagerDuty Integration Key (if PagerDuty routing is configured)
PAGERDUTY_SERVICE_KEY=CHANGEME_PAGERDUTY_INTEGRATION_KEY

# ------------------------------------------------------------------------------
# 6. Container Resource Limits & UID/GID Alignment
# ------------------------------------------------------------------------------
PROMETHEUS_UID=65534
PROMETHEUS_GID=65534
GRAFANA_UID=472
GRAFANA_GID=472
ALERTMANAGER_UID=65534
ALERTMANAGER_GID=65534
LOKI_UID=10001
LOKI_GID=10001

# ------------------------------------------------------------------------------
# 7. Disaster Recovery & Backup Settings
# ------------------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
